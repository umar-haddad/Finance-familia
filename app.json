{
  "expo": {
    "name": "Finance Familia",
    "slug": "finance-apps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-finance-familia.png",
    "scheme": "financeappsoffline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.personalfinance.offline",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.personalfinance.offline",
      "icon": "./assets/images/icon-finance-familia.png",
      "adaptiveIcon": {
        "backgroundColor": "#143C34",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#143C34",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "37d687b5-5311-4d95-b61b-2eed39eb15de"
      }
    },
    "owner": "skay-apk"
  }
}
